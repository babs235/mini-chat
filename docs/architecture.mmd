flowchart TD
    Dev["Développeur\ngit push main"]
    User["Utilisateur\nhttps://chat.ibrahimbabikir.fr"]

    subgraph CI["GitHub Actions — Pipeline CI/CD"]
        direction LR
        J1["Job 1\nTests Jest"]
        J2["Job 2\nBuild + Push ECR"]
        J3["Job 3\nSmoke tests pré-prod"]
        J4["Job 4\nTerraform deploy"]
        J1 --> J2 --> J3 --> J4
    end

    subgraph SECRETS["Secrets"]
        GHS["GitHub Secrets\nAWS / DB / JWT"]
        SSM["SSM Parameter Store\nSecureString AES-256"]
        GHS -->|"TF_VAR_*"| SSM
    end

    subgraph AWS["AWS eu-west-3 Paris"]
        subgraph PUB["Subnets publics"]
            ACM["ACM\nchat.ibrahimbabikir.fr\nTLS 1.3"]
            ALB["ALB\nport 443 HTTPS\nport 80 → redirect 301"]
            ECS["ECS Fargate\nNode.js :3000\n0.25 vCPU / 512 MB"]
        end

        subgraph PRIV["Subnets privés"]
            RDS["RDS MySQL 8.0\ndb.t3.micro / 20 Go\nbackup 1 jour"]
        end

        subgraph OBS["Supervision"]
            CW["CloudWatch\nlogs + 4 alarmes"]
            SNS["SNS\nnotification email"]
        end

        ECR["ECR\nimage :sha-commit"]
    end

    S3["S3\nTerraform state"]

    User -->|"HTTPS"| ACM
    ACM --> ALB
    Dev --> CI
    J2 -->|"push image"| ECR
    J4 -->|"terraform apply"| AWS
    J4 -.->|"state"| S3
    ECR -->|"pull au démarrage"| ECS
    SSM -->|"secrets injectés"| ECS
    ALB -->|"port 3000"| ECS
    ECS -->|"port 3306"| RDS
    ECS --> CW
    CW -->|"alarme"| SNS

    style CI fill:#1a1a2e,color:#fff
    style AWS fill:#0a2342,color:#fff
    style SECRETS fill:#1a2e1a,color:#fff
    style PUB fill:#0d3b6e,color:#fff
    style PRIV fill:#3b0d0d,color:#fff
    style OBS fill:#1a3b1a,color:#fff
